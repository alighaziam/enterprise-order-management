# Local development only. Replace every value before running Compose.
DB_USERNAME=app
DB_PASSWORD=change-this-local-password
APP_PORT=8080
APP_SECURITY_ENABLED=true
WSO2_ISSUER_URI=https://localhost:9443/oauth2/token
WSO2_JWKS_URI=https://localhost:9443/oauth2/jwks

# Payment adapter selection. Only sandbox is implemented; configure a provider adapter before changing this.
PAYMENT_PROVIDER=sandbox

# Optional broker transport; keep in-process for the default local demo.
OUTBOX_TRANSPORT=in-process
OUTBOX_KAFKA_TOPIC=eom.outbox.events
OUTBOX_KAFKA_PUBLISH_TIMEOUT_MS=10000
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
